{
  "name": "sandbox-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/pages.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview",
    "bundle:pages": "tsc --noEmit && vite build && node scripts/pages.mjs --publish-root",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "blockly": "12.3.1",
    "pixi.js": "8.14.3",
    "planck": "1.5.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "playwright": "1.65.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
